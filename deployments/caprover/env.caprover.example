# =====================================================================
#  Plane (Community) — variáveis de ambiente para o app CapRover
#  Cole em: App Configs -> Environmental Variables -> Bulk Edit
#  Ajuste todos os valores antes de salvar.
# =====================================================================

# ---- Obrigatórias -----------------------------------------------------
DOMAIN_NAME=plane.seudominio.com
DATABASE_URL=postgresql://plane:senha@srv-captain--plane-db:5432/plane
REDIS_URL=redis://srv-captain--plane-redis:6379/
AMQP_URL=amqp://plane:senha@srv-captain--plane-mq:5672/plane

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=troque-me
AWS_SECRET_ACCESS_KEY=troque-me
AWS_S3_BUCKET_NAME=uploads

# ---- Fortemente recomendadas em produção ------------------------------
# Gere cada uma com: openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-aleatoria
LIVE_SERVER_SECRET_KEY=troque-por-uma-chave-aleatoria
APP_PROTOCOL=https

# ---- Opcionais --------------------------------------------------------
# Para MinIO, aponte para a URL do serviço; para AWS S3 pode remover a linha.
AWS_S3_ENDPOINT_URL=http://srv-captain--plane-minio:9000
FILE_SIZE_LIMIT=5242880
GUNICORN_WORKERS=1
API_KEY_RATE_LIMIT=60/minute
USE_MINIO=0
