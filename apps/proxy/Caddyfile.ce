(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	# Internal realtime publish endpoint: only the api/worker containers call it, directly on live:3000.
	@realtime_publish path /live/realtime/publish /live/realtime/publish/*
	respond @realtime_publish 404

	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	# MinIO: a edição comunitária foi arquivada e a versão em uso tem escrita sem a chave secreta
	# (CVE-2026-40344, CVE-2026-41145, só com a access key que vai em toda URL pré-assinada). Daqui só
	# passa o que o navegador usa: ler objeto (GET/HEAD com URL pré-assinada) e o upload por formulário
	# com policy assinada pela API (POST multipart na raiz do bucket). As chamadas do próprio servidor
	# (cópia, avatar, exclusão) vão direto a plane-minio:9000 pela rede interna.
	@minio_read {
		method GET HEAD
		path /{$BUCKET_NAME}/*
		not path /{$BUCKET_NAME}/
	}
	handle @minio_read {
		request_header -X-Amz-*
		request_header -X-Minio-*
		request_header -X-Http-Method-Override
		reverse_proxy plane-minio:9000
	}

	@minio_upload {
		method POST
		path /{$BUCKET_NAME} /{$BUCKET_NAME}/
		header Content-Type multipart/form-data*
		expression {query} == ""
	}
	handle @minio_upload {
		request_header -X-Amz-*
		request_header -X-Minio-*
		request_header -X-Http-Method-Override
		reverse_proxy plane-minio:9000
	}

	@minio_other path /{$BUCKET_NAME} /{$BUCKET_NAME}/*
	respond @minio_other 403

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}